<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F0E8">
 <Grid.Resources>
  <SolidColorBrush x:Key="Ink" Color="#262725"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#44433E"/><Setter Property="BorderBrush" Value="#C8C3B7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="31"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#E7E2D6"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="#DCD5C5"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderThickness" Value="1"/><Setter TargetName="Body" Property="BorderBrush" Value="#917349"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#45463F"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Track" Width="23" Height="12" Background="#D7D1C4" CornerRadius="6" HorizontalAlignment="Left"/><Ellipse x:Name="Dot" Width="8" Height="8" Fill="#FAF8F2" HorizontalAlignment="Left" Margin="2,0,0,0"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#87704D"/><Setter TargetName="Dot" Property="Margin" Value="13,0,0,0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#92692E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#30312D"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderBrush="#C9C4B8" BorderThickness="0,0,0,1"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#807969"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="0,0,22,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#FCFAF4" BorderBrush="#CBC5B8" BorderThickness="1" MinWidth="215"><ScrollViewer MaxHeight="270"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="9,7"/><Setter Property="Foreground" Value="#30312D"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#E9E2D4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Height="22"><Border Height="2" Background="#CEC8BB" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="2" Background="#87704D"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="8" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#363831" CornerRadius="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.Thumb><Thumb Width="3" HorizontalAlignment="Right"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#C8C1B1" CornerRadius="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.DecreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand" Focusable="False"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#756F63"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="Divider" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="#DCD6C9"/><Setter Property="Margin" Value="0,15"/></Style>
 </Grid.Resources>
 <Grid Margin="40,26,40,18">
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="弦光" FontFamily="SimSun" FontSize="29" Margin="0,0,18,0"/><StackPanel Margin="0,3,0,0"><TextBlock Text="P I A N O   S T U D I O" FontFamily="Segoe UI" FontSize="10" Foreground="#686A61"/><TextBlock Text="多维交互电子乐器" FontSize="9" Foreground="#756F63" Margin="0,5,0,0"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="ConnectionBadge" Text="动画预览" FontSize="10" Foreground="#8C7652" VerticalAlignment="Center" Margin="0,0,19,0"/><Button x:Name="ConnectButton" Content="连接  F10"/><Button x:Name="HelpButton" Content="快捷键  F1" Margin="6,0"/><Button x:Name="FullButton" Content="全屏  F11"/></StackPanel>
   <Border Height="1" Background="#C9C3B6" VerticalAlignment="Bottom"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,24,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="239"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock x:Name="TimbreEyebrow" Text="01 / 08" FontSize="10" Foreground="#8C7652"/><TextBlock x:Name="TimbreTitle" Text="柔和钢琴" FontFamily="SimSun" FontSize="34" Margin="0,12,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ChordLabel" Text="等待弹奏" FontSize="18" Foreground="#71694F" HorizontalAlignment="Right"/><TextBlock x:Name="VoiceLabel" Text="A + D + G · C 大三和弦" FontSize="10" Foreground="#756F63" HorizontalAlignment="Right" Margin="0,8,0,0"/></StackPanel></Grid>
    <ContentControl x:Name="StageHost" Grid.Row="1" Focusable="False"/>
    <Grid Grid.Row="2" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OctaveDown" Content="−  Z" Padding="6,4"/><TextBlock x:Name="OctaveLabel" Text="C4 — B4" VerticalAlignment="Center" FontSize="11" Margin="14,0" Foreground="#746E60"/><Button x:Name="OctaveUp" Content="+  X" Padding="6,4"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DemoButton" Content="试听示范  F2" Margin="0,0,13,0"/><Button x:Name="PanicButton" Content="全部松键  Esc"/></StackPanel></Grid>
   </Grid>
   <Border Grid.Column="2" BorderBrush="#D7D0C1" BorderThickness="1,0,0,0" Padding="23,0,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
     <TextBlock Text="音色 · 1 — 8" Style="{StaticResource Caption}"/><ComboBox x:Name="TimbreCombo" AutomationProperties.Name="音色 数字1到8"/>
     <Border Style="{StaticResource Divider}"/>
     <TextBlock Text="声音输出" Style="{StaticResource Caption}"/><ComboBox x:Name="OutputCombo" AutomationProperties.Name="板载喇叭输出" FontSize="10"/>
     <TextBlock x:Name="OutputText" Text="等待连接" FontSize="9" TextTrimming="CharacterEllipsis" Foreground="#756F63" Margin="0,7,0,12"/>
     <Grid><TextBlock Text="喇叭音量" FontSize="11"/><TextBlock x:Name="VolumeText" Text="100%" HorizontalAlignment="Right" FontSize="11"/></Grid><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10" Margin="0,5,0,0"/>
     <Button x:Name="ResetButton" Content="恢复 100%  F5" BorderThickness="1" Margin="0,8,0,0"/>
     <Border Style="{StaticResource Divider}"/>
     <Grid Margin="0,0,0,6"><TextBlock Text="姿态表情" FontSize="11"/><TextBlock x:Name="SensorBadge" Text="待连接" FontSize="9" Foreground="#8C7652" HorizontalAlignment="Right"/></Grid>
     <CheckBox x:Name="TiltCheck" Content="倾斜音量  F3"/><TextBlock x:Name="GainText" Text="100% · 已锁定" FontSize="10" Foreground="#7B7363" Margin="0,8,0,7"/>
     <ProgressBar x:Name="GainMeter" Maximum="100" Value="100" Height="2" BorderThickness="0" Background="#DBD4C6" Foreground="#9F8053"/>
     <Button x:Name="LockButton" Content="解锁音量  F4" BorderThickness="1" Margin="0,10,0,3"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="CalibrateButton" Content="校准 F6" Padding="0,5"/><Button x:Name="DiagnoseButton" Grid.Column="1" Content="检测 Shift+F6" Padding="0,5" FontSize="9"/></Grid>
     <Border Style="{StaticResource Divider}"/>
     <CheckBox x:Name="RoomCheck" Content="房间余音  F7"/><CheckBox x:Name="VibratoCheck" Content="摇动颤音  F8"/><CheckBox x:Name="PedalCheck" Content="保持延音  F9"/>
     <Button x:Name="MotionButton" Content="音符轨迹 · F12" HorizontalAlignment="Left" Padding="0,6" Foreground="#817B6D" Margin="0,8,0,0"/>
     <TextBlock x:Name="SensorDetail" Text="连接开发板后即可演奏。" TextWrapping="Wrap" FontSize="9" Foreground="#756F63" LineHeight="15" Margin="0,8,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="连接开发板，开始演奏" Foreground="#756F63" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/><TextBlock x:Name="StatsText" Grid.Column="1" Text="空格延音  /  Z X 八度  /  PgUp PgDn 音量" Foreground="#756F63" FontSize="9"/></Grid>
 </Grid>
 <Border x:Name="HelpOverlay" Visibility="Collapsed" Background="#F3F0E8" BorderBrush="#C8BDAA" BorderThickness="1" Padding="40" Margin="70,45">
  <Grid><Grid.RowDefinitions><RowDefinition Height="61"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions><TextBlock Text="演奏与控制" FontFamily="SimSun" FontSize="30"/><TextBlock Grid.Row="1" FontSize="14" LineHeight="31" TextWrapping="Wrap" Text="A W S E D F T G Y H U J    12 个半音，可同时弹奏&#10;空格    临时延音         Z / X    降低 / 升高八度&#10;1 — 8    音色             PgUp / PgDn 或 + / −    音量&#10;声音从开发板小喇叭播放；电脑仅作控制与显示&#10;&#10;F2  示范          F3  倾斜音量          F4  锁定 / 解锁音量&#10;F5  恢复 100%   F6  校准姿态          F7  房间余音&#10;F8  摇动颤音     F9  保持延音          F10  重新连接&#10;F11  全屏        F12  音符轨迹          Esc  全部松键&#10;&#10;Tab / Shift+Tab 选择控件，Enter 操作按钮。&#10;切换窗口会自动松键。未接板时仅预览界面，不发声。"/><Button x:Name="CloseHelp" Grid.Row="2" Content="返回演奏  F1 / Esc" HorizontalAlignment="Left" BorderThickness="1"/></Grid>
 </Border>
</Grid>
